# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# 编辑器 / IDE
.vscode/
.idea/

# 日志与临时文件
*.log
*.tmp
ql_thumb/

# Office 临时/锁文件
~$*.pptx
~$*.docx
~$*.xlsx

# 仿真运行产出（可复现，无需入库）
design/results/
design/figures/

# 渲染产物（可复现，本地生成即可；SVG 入库，PNG 不入库）
design/renders/*.png

# 交接包内的图片附件（由 gen_handoff.py 从 renders/drawings 复制，可复现）
design/handoff/*.png

# Webots 联调产物（run_webots_batch.ps1 / 控制器 --report --log 生成）
/atri_report.json
/atri_console.log

# CadQuery 独立环境与 CAD 产出（体积大，可复现）
.venv-cad/
design/cad/out/
# ── 答辩 PPT 生产流水线（ppt/） ─────────────────────────────
# 虚拟环境
.venv-ppt/

# 逐页渲染图：由 build.sh 从 pptx 自动生成，无需入库（51 张 ≈ 7MB）
ppt/out/pdf_p*.png
ppt/out/preview/

# 轻量版 PDF：由定稿 PDF 一条命令派生
ppt/out/*轻量版.pdf

# AI 生成的大图（4 张，约 19MB）：当前构建器未引用，留在本地
# 若将来要用，删掉下面这行再 git add 即可
ppt/assets/*.png
