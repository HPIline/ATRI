# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# 编辑器 / IDE
.vscode/
.idea/

# 日志与临时文件
*.log
*.tmp
ql_thumb/

# Office 临时/锁文件
~$*.pptx
~$*.docx
~$*.xlsx

# 仿真运行产出（可复现，无需入库）
design/results/
design/figures/

# 渲染产物（可复现，本地生成即可；SVG 入库，PNG 不入库）
design/renders/*.png
design/drawings/preview_*.png

# 交接包内的图片附件（由 gen_handoff.py 从 renders/drawings 复制，可复现）
design/handoff/*.png

# Webots 联调产物（run_webots_batch.ps1 / 控制器 --report --log 生成）
/atri_report.json
/atri_console.log

# CadQuery 独立环境与 CAD 产出（体积大，可复现）
.venv-cad/
design/cad/out/

# ── 答辩 PPT 生产流水线（ppt/） ─────────────────────────────
.venv-ppt/
ppt/out/

# 忽略整个 ppt/ 生成流水线与脚本，仅保留成品 PPTX
ppt/*
!ppt/ATRI-答辩PPT-v4.pptx

# ── T-01 人脸识别（2026-09-12） ──────────────────────────────
# 人脸模型（约 37 MB 二进制，按需拉取而不是入库；拉取带 sha256 校验）
#   python software/atri/tools/fetch_models.py
models/

# 本地数据：人脸数据集与采集原图。**含生物特征，绝不入库。**
# 人脸库里只存 128 维特征向量与姓名（software/atri/config/face_db.json），原图一律留在本地。
本地数据/

# 人脸开发环境（opencv-contrib + pyarrow）
.venv-face/
