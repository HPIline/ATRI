{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HPIline/ATRI/schemas/action_library.json",
  "title": "A.T.R.I. Action Library",
  "type": "object",
  "required": ["schema_version", "action_id", "frames"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "loop": {"type": "boolean"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["duration_s", "joints"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "joints": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          },
          "comment": {"type": "string"}
        }
      }
    },
    "meta": {"type": "object"}
  }
}
