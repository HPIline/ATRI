{
  "schema_version": "1.2",
  "name": "ATRI",
  "model_status": "design-provisional",
  "description": "A.T.R.I. 小人形组 22 DOF 设计模型 v2（尺寸对齐 TonyPi Pro 参考机，质量改为真实分布）。v2 的 link 质量 = 结构壳 + 装在其上的舵机 + 装在其内的电子件 + 分摊线束，因此 sum(link mass) == 实物口径总重，URDF 可直接用于刚体动力学仿真。",
  "units": "mm",
  "coordinate_frame": {
    "origin": "骨盆 link 几何中心",
    "x_axis": "机器人正前方",
    "y_axis": "机器人左侧",
    "z_axis": "竖直向上"
  },
  "base_pose_mm": [
    0.0,
    0.0,
    194.2
  ],
  "overall": {
    "height_mm": 372.8,
    "width_mm": 190.0,
    "depth_mm": 123.0,
    "mass_kg": 3.136,
    "note": "v3：结构件按 CAD 实装实算 1790 g（v2 合成预算为 500 g），整机 3.437 kg。**实装包络见 installed_envelope_mm（418 mm 高）**，overall 里的包络是基元/运动学口径。"
  },
  "design_constraints": {
    "competition_max_height_mm": 600.0,
    "competition_max_width_mm": 300.0,
    "competition_max_depth_mm": 300.0,
    "competition_min_dof": 18,
    "competition_min_leg_dof_per_side": 4,
    "competition_min_upper_dof": 10,
    "single_arm_max_length_mm": 300.0,
    "battery_min_voltage_v": 7.4
  },
  "link_styles": {
    "joint_shell": "球形关节壳：包住总线舵机，两端留出轴与线缆出口",
    "link_body": "胶囊连杆：两端圆头，减少极限姿态下的干涉与应力集中",
    "shell": "圆角壳体：内部布置电路板、电池与走线",
    "foot": "圆角足底板：加大支撑面，前端略上翘以利摆动相离地",
    "segment": "连杆实体用 origin_mm 从本关节延伸到下一关节，保证外形连续无悬空"
  },
